<?xml version="1.0" encoding="UTF-8"?>
<!--
  Detoxblanc OMS — IIS / Windows hosting config (Plesk Windows, Azure App Service)
-->
<configuration>
  <system.webServer>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <!-- ── URL rewrite — clean admin URLs ── -->
    <rewrite>
      <rules>
        <rule name="admin-root">       <match url="^admin/?$" />              <action type="Rewrite" url="admin.html" /></rule>
        <rule name="admin-login">      <match url="^admin/login$" />          <action type="Rewrite" url="admin-login.html" /></rule>
        <rule name="admin-orders">     <match url="^admin/orders$" />         <action type="Rewrite" url="admin-orders.html" /></rule>
        <rule name="admin-customers">  <match url="^admin/customers$" />      <action type="Rewrite" url="admin-customers.html" /></rule>
        <rule name="admin-inventory">  <match url="^admin/inventory$" />      <action type="Rewrite" url="admin-inventory.html" /></rule>
        <rule name="admin-products">   <match url="^admin/products$" />       <action type="Rewrite" url="admin-products.html" /></rule>
        <rule name="admin-product-edit"><match url="^admin/products/edit$" /> <action type="Rewrite" url="admin-product-edit.html" /></rule>
        <rule name="admin-collections"><match url="^admin/collections$" />    <action type="Rewrite" url="admin-collections.html" /></rule>
        <rule name="admin-articles">   <match url="^admin/articles$" />       <action type="Rewrite" url="admin-articles.html" /></rule>
        <rule name="admin-pages">      <match url="^admin/pages$" />          <action type="Rewrite" url="admin-pages.html" /></rule>
        <rule name="admin-reviews">    <match url="^admin/reviews$" />        <action type="Rewrite" url="admin-reviews.html" /></rule>
        <rule name="admin-newsletter"> <match url="^admin/newsletter$" />     <action type="Rewrite" url="admin-newsletter.html" /></rule>
        <rule name="admin-vouchers">   <match url="^admin/vouchers$" />       <action type="Rewrite" url="admin-vouchers.html" /></rule>
        <rule name="admin-returns">    <match url="^admin/returns$" />        <action type="Rewrite" url="admin-returns.html" /></rule>
        <rule name="admin-reports">    <match url="^admin/reports$" />        <action type="Rewrite" url="admin-reports.html" /></rule>
        <rule name="admin-audit">      <match url="^admin/audit$" />          <action type="Rewrite" url="admin-audit.html" /></rule>
        <rule name="admin-users">      <match url="^admin/users$" />          <action type="Rewrite" url="admin-users.html" /></rule>
        <rule name="admin-settings">   <match url="^admin/settings$" />       <action type="Rewrite" url="admin-settings.html" /></rule>
        <rule name="admin-dev">        <match url="^admin/dev$" />            <action type="Rewrite" url="admin-dev.html" /></rule>

        <!-- Clean public URLs: /about → /about.html if file exists -->
        <rule name="public-clean-urls" stopProcessing="true">
          <match url="^([a-z0-9-]+)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- ── Security headers ── -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=()" />
      </customHeaders>
    </httpProtocol>

    <!-- ── Cache HTML ngắn, asset dài ── -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:05:00" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <!-- Compress -->
    <httpCompression>
      <dynamicTypes>
        <add mimeType="text/html" enabled="true" />
        <add mimeType="text/css" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="application/json" enabled="true" />
      </dynamicTypes>
    </httpCompression>

    <!-- Hide sensitive files -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".env" />
          <add segment=".git" />
          <add segment="node_modules" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".yaml" allowed="false" />
          <add fileExtension=".firebaserc" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>
